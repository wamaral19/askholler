NODE_ENV=development
DATABASE_URL=postgresql://holler:holler@localhost:5432/holler
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Explicit development/test-only operations composition. Production-like
# environments must not use either synthetic mode.
HOLLER_OPERATIONS_MODE=synthetic-postgres
# Opaque token -> server-owned tenant/actor mapping. Replace with OIDC before launch.
HOLLER_SYNTHETIC_WORKFORCE_SESSIONS={"local-synthetic-session":{"merchantId":"00000000-0000-7000-8000-000000000001","researcherId":"00000000-0000-7000-8000-000000000002","enabled":true,"roles":["researcher","merchant_admin"]}}
WORKFORCE_AUTH_PROVIDER=synthetic
# Production requires OIDC with an MFA-capable provider and a real managed KMS key.
# OIDC_ISSUER=https://identity-provider.invalid/
# OIDC_AUDIENCE=holler-workforce
# PII_KMS_KEY_ID=managed-kms-key-identifier

# Fake providers are mandatory for local development by default.
DIALER_PROVIDER=fake
TRANSCRIPTION_PROVIDER=fake
OBJECT_STORE_PROVIDER=fake

# Approved production providers. Keep actual values in the deployment secret
# store; never commit them. SMS remains disabled until separately approved.
# DIALER_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
# TWILIO_API_KEY_SID=SK00000000000000000000000000000000
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
# TWILIO_TWIML_APP_SID=AP00000000000000000000000000000000
# TWILIO_CALLER_ID=+12025550123
# TWILIO_CALL_INTENT_SECRET=
# OBJECT_STORE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=holler-production-private

# Shopify app values are required only for Shopify-backed development.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=read_orders,read_products,read_customers

# Add real provider and Shopify secrets only to untracked environment files
# or the deployment platform's secret manager.
